<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

# Prevent indexing of specific directories safely in .htaccess
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/(psikologi|sistempakar)(/.*)?$" NOINDEX_DIR
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_DIR
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Gzip / Deflate Compression for High Speed and Core Web Vitals
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/opentype application/vnd.ms-fontobject
</IfModule>

# Enable Browser Caching via mod_expires
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

Options -MultiViews
RewriteEngine On

# Protect internal application & sensitive directories from direct browsing
RewriteRule ^(app|config|vendor)/.*$ - [F,L]

# Ignore the psikologi directory completely
RewriteRule ^psikologi(/.*)?$ - [L]

# Admin Panel pretty URLs (bypass front controller)
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/([^/]+)/?$ admin/$1.php [L,QSA]
RewriteRule ^admin/([^/]+)/([^/]+)/?$ admin/$1/$2.php [L,QSA]

# Don't rewrite existing physical files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Front Controller: Route all public requests through index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Custom Error Documents (Handled by MVC Router / ErrorController)
ErrorDocument 404 /404
ErrorDocument 403 /403
ErrorDocument 500 /500
