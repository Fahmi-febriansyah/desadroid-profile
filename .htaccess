<Files ".env">
    Order Allow,Deny
    Deny from all
</Files>

# Prevent indexing of specific directories safely in .htaccess
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/(psikologi|sistempakar)(/.*)?$" NOINDEX_DIR
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_DIR
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable Gzip / Deflate Compression for High Speed and Core Web Vitals
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/opentype application/vnd.ms-fontobject
</IfModule>

# Enable Browser Caching via mod_expires
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

Options -MultiViews
RewriteEngine On

# Ignore the psikologi directory completely
RewriteRule ^psikologi(/.*)?$ - [L]
# Don't rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty URL for article detail: /artikel/slug -> artikel_detail.php?slug=slug
RewriteRule ^artikel/([^/]+)/?$ artikel_detail.php?slug=$1 [L,QSA]

# Pretty URL for article list: /artikel -> artikel.php
RewriteRule ^artikel/?$ artikel.php [L,QSA]

# Pretty URL for project detail: /proyek/slug -> project_detail.php?slug=slug
RewriteRule ^proyek/([^/]+)/?$ project_detail.php?slug=$1 [L,QSA]

# Pretty URL for project list: /proyek -> proyek.php
RewriteRule ^proyek/?$ proyek.php [L,QSA]

# Admin pretty URLs: /admin -> admin/index.php, /admin/dashboard -> admin/dashboard.php
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [L,QSA]
# Admin subpages: /admin/section[/sub] -> admin/section.php or admin/section/sub.php
RewriteRule ^admin/([^/]+)/?$ admin/$1.php [L,QSA]
RewriteRule ^admin/([^/]+)/([^/]+)/?$ admin/$1/$2.php [L,QSA]

# Generic pretty URLs for top-level pages (e.g. /tentang -> tentang.php)
# This will only apply when the requested path isn't an existing file/dir (handled above).
RewriteRule ^([A-Za-z0-9-]+)/?$ $1.php [L,QSA]
